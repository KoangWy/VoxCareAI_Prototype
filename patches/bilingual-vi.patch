+"""Conversation languages: Vietnamese (vi-VN) and English (en-US).
+
+A session's locale is chosen by the caller when the session starts and stays
+fixed for it; it selects the speech models and the language of every
+rendered answer. Tool arguments and records stay language-neutral (ORD-####
+codes, SKUs, English category enums, integer VND).
+"""
+
+from __future__ import annotations
+
+VI = "vi-VN"
+EN = "en-US"
+SUPPORTED_LOCALES = (VI, EN)
+# What the REST API assumes when a client sends no locale (keeps older clients and
+# scripts on English); the browser UI starts in Vietnamese and always sends one.
+API_DEFAULT_LOCALE = EN
+
+_ALIASES = {"vi": VI, "vi-vn": VI, "vi_vn": VI, "en": EN, "en-us": EN, "en_us": EN}
+
+
+def normalize_locale(value: object) -> str:
+    """Canonical locale for ``vi`` / ``vi-VN`` / ``en`` / ``en-US`` (any case); raises ValueError otherwise."""
+    if value is None:
+        return API_DEFAULT_LOCALE
+    if isinstance(value, str):
+        canonical = _ALIASES.get(value.strip().lower())
+        if canonical:
+            return canonical
+    raise ValueError(f"unsupported locale {value!r}; use one of {', '.join(SUPPORTED_LOCALES)}")
+
+
+def is_vietnamese(locale: str | None) -> bool:
+    return locale == VI
+
+
+__all__ = ["API_DEFAULT_LOCALE", "EN", "SUPPORTED_LOCALES", "VI", "is_vietnamese", "normalize_locale"]
