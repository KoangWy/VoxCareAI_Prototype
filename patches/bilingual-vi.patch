+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  DEFAULT_LOCALE, LOCALES, clauseText, clauseTitle, loadLocale, providersForLocale, resolveLocale,
+  saveLocale, sessionRequestInit, strings,
+} from '../../static/i18n.js';
+
+test('Vietnamese is the default and both languages define the same caller-facing strings', () => {
+  assert.equal(DEFAULT_LOCALE, 'vi-VN');
+  assert.deepEqual(LOCALES, ['vi-VN', 'en-US']);
+  assert.deepEqual(Object.keys(strings('vi-VN')).sort(), Object.keys(strings('en-US')).sort());
+  for (const value of Object.values(strings('vi-VN'))) assert.ok(value.length > 0);
+  assert.equal(strings('xx-YY'), strings('vi-VN'));
+  assert.equal(resolveLocale('en-US'), 'en-US');
+  assert.equal(resolveLocale(undefined), 'vi-VN');
+});
+
+test('the remembered language survives missing or throwing storage', () => {
+  const memory = new Map();
+  const storage = { getItem: (k) => memory.get(k) ?? null, setItem: (k, v) => memory.set(k, v) };
+  assert.equal(loadLocale(storage), 'vi-VN');
+  saveLocale(storage, 'en-US');
+  assert.equal(loadLocale(storage), 'en-US');
+  const broken = { getItem() { throw new Error('SecurityError'); }, setItem() { throw new Error('QuotaExceeded'); } };
+  assert.equal(loadLocale(broken), 'vi-VN');
+  assert.doesNotThrow(() => saveLocale(broken, 'en-US'));
+  assert.equal(loadLocale(null), 'vi-VN');
+});
+
+test('speech providers come from the chosen language, the conversation model is shared', () => {
+  const config = {
+    providers: { asr: { name: 'en asr' }, tts: { name: 'en tts' }, conversation: { name: 'llm', configured: true } },
+    languages: {
+      'vi-VN': { asr: { name: 'vi asr', configured: false }, tts: { name: 'vi tts', configured: true } },
+      'en-US': { asr: { name: 'en asr' }, tts: { name: 'en tts' } },
+    },
+  };
+  const vi = providersForLocale(config, 'vi-VN');
+  assert.equal(vi.asr.name, 'vi asr');
+  assert.equal(vi.tts.name, 'vi tts');
+  assert.equal(vi.conversation.name, 'llm');
+  assert.equal(providersForLocale(config, 'en-US').asr.name, 'en asr');
+  assert.deepEqual(providersForLocale({ providers: { asr: 1 } }, 'vi-VN'), { asr: 1 }); // older server: no languages
+});
+
+test('policy evidence shows the Vietnamese clause when there is one', () => {
+  const item = { content_en: 'English text', content_vi: 'Văn bản tiếng Việt', title: 'Title', title_vi: 'Tiêu đề' };
+  assert.equal(clauseText(item, 'vi-VN'), 'Văn bản tiếng Việt');
+  assert.equal(clauseText(item, 'en-US'), 'English text');
+  assert.equal(clauseText({ content_en: 'only English' }, 'vi-VN'), 'only English');
+  assert.equal(clauseTitle(item, 'vi-VN'), 'Tiêu đề');
+});
+
+test('session create/reset carries the language as JSON', () => {
+  const init = sessionRequestInit('en-US');
+  assert.equal(init.method, 'POST');
+  assert.equal(init.headers['Content-Type'], 'application/json');
+  assert.deepEqual(JSON.parse(init.body), { locale: 'en-US' });
+  assert.deepEqual(JSON.parse(sessionRequestInit('bogus').body), { locale: 'vi-VN' });
+});
