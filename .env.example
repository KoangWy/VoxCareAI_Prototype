# VoxCare AI configuration. Copy to .env (git-ignored) and fill in one stack.
# Every VOXCARE_* value is validated at session creation (src/voxcare/config.py);
# an invalid value fails loudly with the variable name. Leave a line empty to use
# its default. Keys stay server-side and are never returned by the API.

# --- Provider credentials -----------------------------------------------------
OPENAI_API_KEY=            # OpenAI, or the key of the OpenAI-compatible gateway when TRANSPORT=chat
ANTHROPIC_API_KEY=         # optional sticky fallback after two retryable primary failures
DEEPGRAM_API_KEY=          # ASR when VOXCARE_ASR_PROVIDER=deepgram
ELEVENLABS_API_KEY=        # TTS when VOXCARE_TTS_PROVIDER=elevenlabs
ELEVENLABS_VOICE_ID=
TYPESAFE_API_KEY=          # turn judge when VOXCARE_TURN_MODE=jev
OPENROUTER_API_KEY=        # turn judge when VOXCARE_TURN_MODE=openrouter

# --- Speech -------------------------------------------------------------------
VOXCARE_ASR_PROVIDER=deepgram      # deepgram | vosk
VOXCARE_VOSK_MODEL=                # e.g. models/vosk-model-small-en-us-0.15
VOXCARE_TTS_PROVIDER=elevenlabs    # elevenlabs | piper
VOXCARE_PIPER_MODEL=               # e.g. models/en_US-lessac-medium.onnx
VOXCARE_ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Conversation model -------------------------------------------------------
VOXCARE_OPENAI_TRANSPORT=responses # responses (OpenAI Responses API) | chat (chat-completions gateway)
VOXCARE_OPENAI_MODEL=gpt-6-luna
VOXCARE_OPENAI_BASE_URL=
VOXCARE_OPENAI_MAX_TOKENS=1024     # chat transport only; reasoning tokens count toward it
VOXCARE_OPENAI_REASONING_EFFORT=   # chat transport only, e.g. low; leave empty if the gateway rejects it
VOXCARE_OPENAI_SESSION_HEADER=     # pin one x-opencode-session value (default: one per VoxCare session)
VOXCARE_ANTHROPIC_MODEL=claude-haiku-5-5
VOXCARE_ANTHROPIC_BASE_URL=

# --- Turn control (docs/TURN_CONTROL.md) ---------------------------------------
VOXCARE_TURN_MODE=baseline         # baseline | jev | openrouter
VOXCARE_JEV_MODEL=                 # default: jev-latest (jev) or inception/mercury-decide (openrouter)
VOXCARE_BARGE_IN=off               # off (half-duplex) | semantic
# Per-mode defaults: baseline/jev 300 ms / 3000 ms, openrouter 2500 ms / 9000 ms.
VOXCARE_JEV_TIMEOUT_MS=
VOXCARE_HOLD_DEADLINE_MS=
# Advanced tuning (defaults in src/voxcare/turns/controller.py):
# VOXCARE_TURN_COMPLETE_THRESHOLD=0.72
# VOXCARE_EOS_THRESHOLD_FLOOR=0.55
# VOXCARE_EOS_DECAY_MS=3000
# VOXCARE_HOLDING_FLOOR_THRESHOLD=0.50
# VOXCARE_ADDRESSED_TO_AGENT_THRESHOLD=0.50
# VOXCARE_TAKING_FLOOR_THRESHOLD=0.50
# VOXCARE_MIN_STABLE_WORD_RATIO=0.90
# VOXCARE_EOS_CONFIRM_QUIET_MIN_MS=350
# VOXCARE_EOS_CONFIRM_QUIET_MAX_MS=1000
# VOXCARE_EOS_MAX_SILENCE_MS=5000
# VOXCARE_EOS_MAX_SILENCE_HOLDING_MS=12000

VOXCARE_LOG_LEVEL=INFO

# --- Local demo stack (no speech-provider keys) --------------------------------
# uv run --group demo python scripts/fetch_demo_models.py, then:
# VOXCARE_ASR_PROVIDER=vosk
# VOXCARE_VOSK_MODEL=models/vosk-model-small-en-us-0.15
# VOXCARE_TTS_PROVIDER=piper
# VOXCARE_PIPER_MODEL=models/en_US-lessac-medium.onnx
# VOXCARE_OPENAI_TRANSPORT=chat
# VOXCARE_OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
# VOXCARE_OPENAI_MODEL=deepseek-v4.1-flash      # verify against the gateway's /v1/models
# VOXCARE_OPENAI_REASONING_EFFORT=low
# VOXCARE_TURN_MODE=openrouter                  # optional; needs OPENROUTER_API_KEY
