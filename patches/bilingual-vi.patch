+def test_vosk_and_piper_need_their_vietnamese_models(monkeypatch, tmp_path):
+    vi_model = tmp_path / "vosk-vi"
+    vi_model.mkdir()
+    voice = tmp_path / "vi.onnx"
+    voice.write_bytes(b"onnx")
+    monkeypatch.setenv("VOXCARE_ASR_PROVIDER", "vosk")
+    monkeypatch.setenv("VOXCARE_TTS_PROVIDER", "piper")
+    with pytest.raises(ProviderUnavailable) as caught:
+        asr_connection_from_env(VI)
+    assert caught.value.code == "VOSK_MODEL_VI_NOT_CONFIGURED"
+    with pytest.raises(ProviderUnavailable) as caught:
+        tts_from_env(VI)
+    assert caught.value.code == "PIPER_MODEL_VI_NOT_CONFIGURED"
+    monkeypatch.setenv("VOXCARE_VOSK_MODEL_VI", str(vi_model))
+    monkeypatch.setenv("VOXCARE_PIPER_MODEL_VI", str(voice))
+    status = provider_status(VI)
+    assert status["asr"].configured and status["asr"].model == "vosk-vi"
+    assert status["tts"].configured and status["tts"].model == "vi.onnx"
+    assert "Vietnamese" in status["asr"].detail
