+// Caller-facing strings in Vietnamese and English, plus the per-language
+// provider view. Pure module (no DOM) so node tests can cover it. Diagnostic
+// panels (trace, tuning, provider details) stay in English on purpose.
+
+export const LOCALES = Object.freeze(['vi-VN', 'en-US']);
+export const DEFAULT_LOCALE = 'vi-VN';
+const STORAGE_KEY = 'voxcare.locale';
+
+const STRINGS = Object.freeze({
+  'vi-VN': Object.freeze({
+    htmlLang: 'vi',
+    languageLabel: 'Ngôn ngữ',
+    introEyebrow: 'TIẾNG VIỆT · CHỈ TRA CỨU',
+    introTitle: 'Tôi có thể giúp gì cho bạn hôm nay?',
+    introBody: 'Hỏi về đơn hàng hoặc giao hàng (thử ORD-1002), tìm hoặc so sánh TV và máy giặt, kiểm tra voucher VOXCOM_500K, hoặc hỏi về chính sách giao hàng, lắp đặt, bảo hành và đổi trả. Phiên demo giả lập này gắn với khách hàng CUST-001.',
+    reset: 'Bắt đầu phiên mới',
+    micStart: 'Bắt đầu nói',
+    micUnavailable: 'Giọng nói tiếng Việt chưa sẵn sàng',
+    micListening: 'Đang nghe…',
+    micHelpListening: 'Hãy nói tự nhiên. Khoảng lặng chỉ được ghi nhận, không tự động kết thúc lượt nói.',
+    micHelpIdle: 'Âm thanh micro được gửi tới dịch vụ nhận dạng tiếng Việt đã cấu hình.',
+    transcriptPlaceholder: 'Lời bạn nói sẽ hiện ở đây.',
+    inputPlaceholder: 'Thử: Đơn hàng ORD-1002 đang ở đâu?',
+    send: 'Gửi',
+    limits: 'Tiếng Việt và tiếng Anh · Danh tính giả lập · Không chuyển máy trực tiếp',
+  }),
+  'en-US': Object.freeze({
+    htmlLang: 'en',
+    languageLabel: 'Language',
+    introEyebrow: 'ENGLISH · READ ONLY',
+    introTitle: 'How can I help you today?',
+    introBody: 'Ask about an order or delivery (try ORD-1002), browse or compare TVs and washers, check the VOXCOM_500K voucher, or ask about shipping, installation, warranty and return policy. This fictional demo session is scoped to customer CUST-001.',
+    reset: 'Reset session',
+    micStart: 'Start speaking',
+    micUnavailable: 'English voice is not ready',
+    micListening: 'Listening…',
+    micHelpListening: 'Speak naturally. Silence is observed, never treated as an automatic end of turn.',
+    micHelpIdle: 'Microphone audio is sent to the configured English speech service.',
+    transcriptPlaceholder: 'Your transcript will appear here.',
+    inputPlaceholder: 'Try: Where is order ORD-1002?',
+    send: 'Send',
+    limits: 'Vietnamese and English · Simulated identity · No live agent transfer',
+  }),
+});
+
+/** A supported locale, falling back to the default for anything else. */
+export function resolveLocale(value) {
+  return LOCALES.includes(value) ? value : DEFAULT_LOCALE;
+}
+
+/** Caller-facing strings for a locale (unknown locales get the default language). */
+export function strings(locale) {
+  return STRINGS[resolveLocale(locale)];
+}
+
+/** The remembered language choice; storage can be missing or throw (private mode, previews). */
+export function loadLocale(storage) {
+  try {
+    return resolveLocale(storage?.getItem(STORAGE_KEY));
+  } catch {
+    return DEFAULT_LOCALE;
+  }
+}
+
+export function saveLocale(storage, locale) {
+  try {
+    storage?.setItem(STORAGE_KEY, resolveLocale(locale));
+  } catch {
+    /* a per-viewer convenience only */
+  }
+}
+
+/**
+ * The provider view for one language: ASR and TTS come from `config.languages[locale]`
+ * (they differ per language); the conversation model and turn judge are shared.
+ */
+export function providersForLocale(config, locale) {
+  const providers = { ...(config?.providers || {}) };
+  const language = config?.languages?.[resolveLocale(locale)];
+  if (language?.asr) providers.asr = language.asr;
+  if (language?.tts) providers.tts = language.tts;
+  return providers;
+}
+
+/** Policy evidence text in the session language (English when no translation exists). */
+export function clauseText(item, locale) {
+  if (resolveLocale(locale) === 'vi-VN' && item?.content_vi) return item.content_vi;
+  return item?.content_en || item?.title || '';
+}
+
+export function clauseTitle(item, locale) {
+  if (resolveLocale(locale) === 'vi-VN' && item?.title_vi) return item.title_vi;
+  return item?.title || '';
+}
+
+/** JSON body for session create/reset. */
+export function sessionRequestInit(locale) {
+  return {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ locale: resolveLocale(locale) }),
+  };
+}
