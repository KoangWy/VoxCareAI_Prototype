+"""Vietnamese and English sessions: locale plumbing, rendered answers, voice rendering, providers."""
+
+import asyncio
+import json
+import re
+import string
+from pathlib import Path
+from typing import ClassVar
+
+import pytest
+from fastapi.testclient import TestClient
+from test_voice_barge_in import FakeASR, _start_and_speak, receive_until
+
+import voxcare.app as api
+from voxcare import providers as voxcare_providers
+from voxcare.contracts import PlannedToolCall
+from voxcare.domain.seed import SeedOMS
+from voxcare.locales import EN, VI, normalize_locale
+from voxcare.providers import ProviderUnavailable, asr_connection_from_env, provider_status, tts_from_env
+from voxcare.session import SessionBoundary
+from voxcare.session.render import TEXT, render_results
+from voxcare.session.speech import POLICY_SCREEN_POINTER_VI, first_sentence, speakable, spoken_reply, vi_number
+from voxcare.session.tools import normalize_spoken_order_codes
+from voxcare.turns import JevJudgment, TurnController
+
+
+class ScriptedDialogue:
+    def __init__(self, *plans):
+        self.plans = list(plans)
+        self.user_texts = []
+
+    async def plan_turn(self, *, user_text, history, available_tools):
+        self.user_texts.append(user_text)
+        return self.plans.pop(0) if self.plans else []
+
+
+ORDER_PLAN = [
+    PlannedToolCall("lookup_order_details", {"order_code": "ORD-1002"}, "c1"),
+    PlannedToolCall("track_shipment_status", {"order_code": "ORD-1002"}, "c2"),
+]
+RETURNS_PLAN = PlannedToolCall(
+    "retrieve_policy_clauses",
+    {"query": "return window for my TV", "category": "RETURNS", "product_category": "TV_AV", "brand": None},
+    "c1",
+)
+
+
+def run_turn(dialogue, text, *, locale=VI, source="manual"):
+    service = SessionBoundary(dialogue=dialogue, oms=SeedOMS())
+
+    async def go():
+        session = await service.create_session(locale)
+        return await service.handle_turn(session.session_id, text, source=source)
+
+    return asyncio.run(go())
+
+
+# -- locale plumbing --
+
+
+@pytest.mark.parametrize(("raw", "canonical"), [("vi", VI), ("VI-vn", VI), ("en", EN), ("en-US", EN), (None, EN)])
+def test_locales_normalize(raw, canonical):
+    assert normalize_locale(raw) == canonical
+
+
+def test_unknown_locale_is_rejected():
+    with pytest.raises(ValueError):
+        normalize_locale("fr-FR")
+
+
+def test_rest_sessions_carry_their_language():
+    with TestClient(api.app) as client:
+        default = client.post("/api/sessions").json()
+        assert default["locale"] == EN  # older clients and scripts stay on English
+        vi = client.post("/api/sessions", json={"locale": "vi"}).json()
+        assert vi["locale"] == VI
+        assert client.post("/api/sessions", json={"locale": "fr"}).status_code == 422
+        kept = client.post(f"/api/sessions/{vi['session_id']}/reset").json()
+        assert kept["locale"] == VI and kept["session_id"] != vi["session_id"]
+        switched = client.post(f"/api/sessions/{kept['session_id']}/reset", json={"locale": "en-US"}).json()
+        assert switched["locale"] == EN
+        handoff = client.post(f"/api/sessions/{vi['session_id']}/handoff", json={}).status_code
+        assert handoff == 404  # the reset fenced the old session
+        fresh = client.post("/api/sessions", json={"locale": VI}).json()
+        message = client.post(f"/api/sessions/{fresh['session_id']}/handoff", json={}).json()["message"]
+        assert message == TEXT[VI]["handoff"]
+
+
+def test_config_reports_speech_readiness_per_language():
+    with TestClient(api.app) as client:
+        config = client.get("/api/config").json()
+    assert config["default_locale"] == VI
+    assert config["locales"] == [VI, EN]
+    assert set(config["languages"]) == {VI, EN}
+    for language in config["languages"].values():
+        assert {"asr", "tts", "voice_ready"} <= set(language)
+
+
+# -- rendered answers --
+
+
+def _fields(template: str) -> set[str]:
+    return {name for _, name, _, _ in string.Formatter().parse(template) if name}
+
+
+def test_every_answer_template_exists_in_both_languages_with_the_same_slots():
+    assert set(TEXT[VI]) == set(TEXT[EN])
+    for key in TEXT[EN]:
+        assert _fields(TEXT[VI][key]) == _fields(TEXT[EN][key]), key
+
+
+def test_vietnamese_order_answer_and_its_spoken_form():
+    result = run_turn(ScriptedDialogue(ORDER_PLAN), "Đơn hàng ORD-1002 đang ở đâu?")
+    assert result.outcome == "ANSWERED"
+    text = result.assistant_text
+    assert "Đơn hàng ORD-1002 đã được gửi đi" in text
+    assert "Sản phẩm: LG 55-inch 4K TV" in text
+    assert "với GHN" in text and "15/10/2026" in text
+    spoken = spoken_reply(text, result.tool_outcomes, VI)
+    assert "ô rờ đê một không không hai" in spoken
+    assert "ngày mười lăm tháng mười năm hai nghìn không trăm hai mươi sáu" in spoken
+    assert not re.search(r"\d", spoken.replace("4K", ""))  # every number is read out in words
+
+
+def test_vietnamese_policy_answer_is_the_translated_clause():
+    result = run_turn(ScriptedDialogue(RETURNS_PLAN), "Chính sách đổi trả TV thế nào?")
+    assert result.outcome == "ANSWERED"
+    for clause in result.evidence:
+        assert clause["content_vi"] in result.assistant_text
+        assert clause["content_en"] not in result.assistant_text
+    assert "POL-RET-001" in result.assistant_text
+    spoken = spoken_reply(result.assistant_text, result.tool_outcomes, VI)
+    assert "POL-" not in spoken
+    assert spoken.endswith(POLICY_SCREEN_POINTER_VI)
+    assert "Còn một điều khoản liên quan khác." in spoken  # numbers are read out in words
+    top = speakable(first_sentence(result.evidence[0]["content_vi"]), VI)
+    assert top in spoken
+
+
+def test_vietnamese_voucher_quote_formats_and_speaks_amounts():
+    plan = PlannedToolCall(
+        "apply_voucher", {"voucher_code": "VOXCOM_500K", "order_value_vnd": 12_000_000, "category": "TV_AV"}, "c1"
+    )
+    result = run_turn(ScriptedDialogue(plan), "Dùng VOXCOM_500K cho TV 12 triệu được không?")
+    assert "giảm 500.000 VND" in result.assistant_text
+    assert "11.500.000 VND" in result.assistant_text
+    spoken = spoken_reply(result.assistant_text, result.tool_outcomes, VI)
+    assert "năm trăm nghìn đồng" in spoken and "mười một triệu năm trăm nghìn đồng" in spoken
+
+
+def test_vietnamese_refusals_and_clarification():
+    out_of_scope = run_turn(
+        ScriptedDialogue([PlannedToolCall("lookup_order_details", {"order_code": "ORD-2002"})]), "x"
+    )
+    assert out_of_scope.assistant_text == TEXT[VI]["order_out_of_scope"]
+    clarify = run_turn(ScriptedDialogue([]), "xin chào")
+    assert clarify.assistant_text == TEXT[VI]["clarify"]
+    handoff = render_results(
+        [type(out_of_scope.tool_outcomes[0])("escalate_to_human", "HANDOFF_REQUEST_RECORDED")], locale=VI
+    )
+    assert handoff == (TEXT[VI]["handoff"], "HANDOFF_REQUEST_RECORDED")
+
+
+def test_english_sessions_are_unchanged():
+    result = run_turn(ScriptedDialogue(ORDER_PLAN), "Where is ORD-1002?", locale=EN)
+    assert result.assistant_text.startswith("Order ORD-1002 is shipped. Item(s): LG 55-inch 4K TV.")
+
+
+def test_policy_translations_keep_every_number():
+    corpus = json.loads(Path("src/voxcare/domain/data/policies.json").read_text(encoding="utf-8"))
+
+    def numbers(text):
+        return sorted(re.findall(r"\d+", re.sub(r"(?<=\d)[.,](?=\d{3}\b)", "", text)))
+
+    for clause in corpus["clauses"]:
+        assert clause["content_vi"].strip() and clause["title_vi"].strip()
+        assert numbers(clause["content_vi"]) == numbers(clause["content_en"]), clause["policy_id"]
+
