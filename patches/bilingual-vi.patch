+# -- the voice socket in a Vietnamese session --
+
+
+class RecordingTTS:
+    texts: ClassVar[list[str]] = []
+
+    @classmethod
+    def from_env(cls):
+        return cls()
+
+    async def stream(self, text):
+        RecordingTTS.texts.append(text)
